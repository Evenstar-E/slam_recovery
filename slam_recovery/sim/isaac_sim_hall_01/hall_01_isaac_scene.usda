#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 350
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 20
    upAxis = "Z"
    customLayerData = {
        string slamRecovery:sourceBag = "hall_01.bag"
        string slamRecovery:sourceMcap = "hall_01_plasticbag_comparison.mcap"
        string slamRecovery:attitudeSource = "IMU AHRS yaw (/handsfree/imu) + calibrated constant offset"
        double slamRecovery:theta0Deg = 99.1
        double slamRecovery:imuTimeOffsetSec = -0.1
        string slamRecovery:trustedVoxelSize = "0.22"
        string slamRecovery:numScans = "118"
    }
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Scope "Looks"
    {
        def Material "Mat_Floor"
        {
            token outputs:surface.connect = </World/Looks/Mat_Floor/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.820, 0.840, 0.860)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.700
                token outputs:surface
            }
        }
        def Material "Mat_Trusted_Wall"
        {
            token outputs:surface.connect = </World/Looks/Mat_Trusted_Wall/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.320, 0.680, 0.860)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.420
                token outputs:surface
            }
        }
        def Material "Mat_B0_Polluted"
        {
            token outputs:surface.connect = </World/Looks/Mat_B0_Polluted/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.920, 0.280, 0.220)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.400
                float inputs:opacity = 0.550
                float inputs:opacityThreshold = 0.01
                bool inputs:enableOpacity = 1
                token outputs:surface
            }
        }
        def Material "Mat_B2_Drift"
        {
            token outputs:surface.connect = </World/Looks/Mat_B2_Drift/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.930, 0.680, 0.160)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.450
                float inputs:opacity = 0.600
                float inputs:opacityThreshold = 0.01
                bool inputs:enableOpacity = 1
                token outputs:surface
            }
        }
        def Material "Mat_GT"
        {
            token outputs:surface.connect = </World/Looks/Mat_GT/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.120, 0.130, 0.150)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.350
                token outputs:surface
            }
        }
        def Material "Mat_Commit"
        {
            token outputs:surface.connect = </World/Looks/Mat_Commit/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.100, 0.620, 0.780)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.300
                token outputs:surface
            }
        }
        def Material "Mat_Checkpoint"
        {
            token outputs:surface.connect = </World/Looks/Mat_Checkpoint/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.140, 0.710, 0.420)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.300
                token outputs:surface
            }
        }
    }

    def Xform "Lights"
    {
        def DomeLight "Sky"
        {
            float inputs:intensity = 850
        }
        def DistantLight "Sun"
        {
            float inputs:angle = 1.2
            float inputs:intensity = 1700
            float3 xformOp:rotateXYZ = (-42, 28, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
    }

