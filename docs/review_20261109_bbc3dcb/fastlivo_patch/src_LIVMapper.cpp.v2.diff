+  for (int64_t i = 0; i < n; ++i) tr::feed_i64le(c, stamps[i]);
+  const int64_t first_ns = n > 0 ? stamps[0] : -1;
+  const int64_t last_ns = n > 0 ? stamps[n - 1] : -1;
+  const std::string sha = tr::final_hex(c);
+  char ln[256];
+  snprintf(ln, sizeof(ln), "IMUINIT,%lld,0,%lld,%lld,%lld,%s,iter=%d|max=%d",
+           (long long)tr::wall_ns(), (long long)n, (long long)first_ns, (long long)last_ns,
+           sha.c_str(), iter, maxc);
+  tr::emit(ln);
+}
+#endif
