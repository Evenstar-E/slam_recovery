+std::string LIVMapper::checkpointStatus() const
+{
+  char buf[512];
+  snprintf(buf, sizeof(buf),
+           "valid=%d stamp_ns=%lld frame=%d voxels=%zu nodes=%zu points=%zu restores=%zu "
+           "live_voxels=%zu live_points=%zu state_pos=%.6f,%.6f,%.6f",
+           (int)cp_valid_, (long long)(cp_stamp_ * 1e9), cp_frame_num_, cp_voxels_, cp_nodes_,
+           cp_points_, cp_restores_, voxelmap_manager->voxel_map_.size(),
+           native_checkpoint::countPoints(voxelmap_manager->voxel_map_), _state.pos_end[0],
+           _state.pos_end[1], _state.pos_end[2]);
+  return std::string(buf);
+}
+
+// One command per file: <dir>/cmd is written atomically by the driver (write - rename) and is
+// renamed to cmd.done before it runs, so a command is executed exactly once even if the poll
+// happens to come back to an unchanged directory.
+void LIVMapper::pollCheckpointControl()
+{
+  if (cp_ctrl_dir_.empty()) return;
+  const double now = ros::WallTime::now().toSec();
+  if (cp_last_poll_wall_ >= 0.0 && (now - cp_last_poll_wall_) < 0.02) return;
+  cp_last_poll_wall_ = now;
+
+  const std::string cmd_path = cp_ctrl_dir_ + "/cmd";
+  std::ifstream in(cmd_path);
+  if (!in.good()) return;
+  std::string cmd;
+  std::getline(in, cmd);
+  in.close();
+  if (cmd.empty()) return;
+
+  const std::string done_path = cp_ctrl_dir_ + "/cmd.done";
+  std::rename(cmd_path.c_str(), done_path.c_str());
+
+  bool ok = false;
+  std::string detail;
+  if (cmd == "snapshot")
+  {
+    ok = snapshotCheckpoint();
+    detail = checkpointStatus();
+  }
+  else if (cmd == "restore")
+  {
+    ok = restoreCheckpoint();
+    detail = checkpointStatus();
+  }
+  else if (cmd == "reprocess")
+  {
+    ok = reprocessCheckpoint();
+    detail = checkpointStatus();
+    {
+      char extra[128];
+      snprintf(extra, sizeof(extra), " replays=%zu replay_frames=%zu buffered=%zu", cp_replays_,
+               cp_replay_frames_, replay_buffer_.size());
+      detail += extra;
+    }
+  }
+  else if (cmd == "status")
+  {
+    ok = true;
+    detail = checkpointStatus();
+  }
+  else
+  {
+    detail = "unknown_command";
+  }
+
+  std::ofstream out(cp_ctrl_dir_ + "/ack", std::ios::trunc);
+  out << (ok ? "OK " : "FAIL ") << cmd << " " << detail << "\n";
+}
