+  cp_replays_++;
+  cp_replay_frames_ += n;
+  ROS_INFO("[NATIVE_CHECKPOINT] reprocess #%zu: %zu frames replayed, map now %zu voxels/%zu points",
+           cp_replays_, n, voxelmap_manager->voxel_map_.size(),
+           native_checkpoint::countPoints(voxelmap_manager->voxel_map_));
+  return true;
+}
