+static inline void init(Ctx &c) {
+  c.h[0]=0x6a09e667; c.h[1]=0xbb67ae85; c.h[2]=0x3c6ef372; c.h[3]=0xa54ff53a;
+  c.h[4]=0x510e527f; c.h[5]=0x9b05688c; c.h[6]=0x1f83d9ab; c.h[7]=0x5be0cd19;
+  c.bytes = 0; c.n = 0;
+}
+static inline void update(Ctx &c, const uint8_t *p, size_t L) {
+  c.bytes += L;
+  while (L) {
+    size_t take = 64 - c.n; if (take > L) take = L;
+    memcpy(c.buf + c.n, p, take); c.n += take; p += take; L -= take;
+    if (c.n == 64) { block(c, c.buf); c.n = 0; }
+  }
+}
+static inline std::string final_hex(Ctx &c) {
+  uint64_t bits = c.bytes * 8;
+  uint8_t pad = 0x80; update(c, &pad, 1);
+  uint8_t z = 0; while (c.n != 56) update(c, &z, 1);
+  uint8_t L[8]; for (int i = 0; i < 8; i++) L[i] = (uint8_t)(bits >> (56 - 8*i));
+  update(c, L, 8);
+  char out[65];
+  for (int i = 0; i < 8; i++) snprintf(out + 8*i, 9, "%08x", c.h[i]);
+  out[64] = 0; return std::string(out);
+}
+static inline void feed_i64le(Ctx &c, int64_t v) {
+  uint8_t b[8]; for (int i = 0; i < 8; i++) b[i] = (uint8_t)((uint64_t)v >> (8*i));
+  update(c, b, 8);
+}
+struct Arrival { int64_t wall_ns; int64_t stamp_ns; size_t buflen; };
+static const size_t RING = 16384;
+static Arrival ring[RING];
+static std::atomic<size_t> head{0}, tail{0};
+static std::atomic<size_t> dropped{0};
+static FILE *fp = nullptr;
+static inline void open() {
+  if (!fp) {
+    const char *p = getenv("TRACE_GROUP_FILE");
+    if (p) {
+      fp = fopen(p, "w");
+      if (fp) {
+        fputs("kind,wall_ns,lid_stamp_ns,n_items,first_stamp_ns,last_stamp_ns,"
+              "stamps_sha256,extra\n", fp);
+        fflush(fp);
+      }
+    }
+  }
+}
+static inline int64_t wall_ns() { return (int64_t)ros::WallTime::now().toNSec(); }
+// A double at 1.6e9 s has a 238 ns ULP, but d*1e9 lands in [2^60,2^61) where the ULP is 256 ns, so
+// llround(d*1e9) collapses about 7 % of adjacent doubles onto the same ns. Splitting the seconds
+// keeps whatever the double actually carries, without adding a 256 ns lattice.
+static inline int64_t to_ns_exact(double d) {
+  const double sec = std::floor(d);
+  return (int64_t)sec * 1000000000LL + (int64_t)llround((d - sec) * 1e9);
+}
+static inline void emit(const char *line) { open(); if (!fp) return; fputs(line, fp); fputc('\n', fp); fflush(fp); }
+static inline void push_arrival(int64_t stamp_ns, size_t buflen) {
+  size_t h = head.load(std::memory_order_relaxed);
+  if (h - tail.load(std::memory_order_acquire) >= RING) {
+    dropped.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  ring[h % RING] = {wall_ns(), stamp_ns, buflen};
+  head.store(h + 1, std::memory_order_release);
+}
