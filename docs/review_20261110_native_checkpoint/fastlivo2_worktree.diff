+    {
+      // observation only: what this package actually contained
+      size_t det_imu_n = 0, det_img_n = 0;
+      double det_img_stamp = -1.0;
+#ifdef TRACE_GROUP
+      int64_t det_imu_first = -1, det_imu_last = -1;
+      tr::Ctx det_sha; tr::init(det_sha); size_t det_imu_n_traced = 0;
+#endif
