+        for (; t < h; ++t) {
+          const tr::Arrival &a = tr::ring[t % tr::RING];
+          tr::Ctx one; tr::init(one); tr::feed_i64le(one, a.stamp_ns);
+          const std::string one_sha = tr::final_hex(one);
+          char ln[256];
+          snprintf(ln, sizeof(ln), "ARRIVE,%lld,%lld,1,%lld,%lld,%s,buflen=%zu",
