+                   (long long)a.stamp_ns, one_sha.c_str(), a.buflen);
+          tr::emit(ln);
+        }
+        tr::tail.store(t, std::memory_order_release);
+        std::string sha = tr::final_hex(det_sha);
+        char ln[512];
+        snprintf(ln, sizeof(ln),
+                 "GROUP,%lld,%lld,%zu,%lld,%lld,%s,mesures=%zu|img=%zu|img_stamp_ns=%lld|need_init=%d",
+                 (long long)tr::wall_ns(),
