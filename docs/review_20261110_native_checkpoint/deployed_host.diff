+           native_checkpoint::countPoints(voxelmap_manager->voxel_map_), _state.pos_end[0],
+           _state.pos_end[1], _state.pos_end[2], (int)map_hold_, held_frames_, held_points_,
+           hold_commands_, repaired_received_, repaired_applied_, repaired_dropped_,
+           repaired_clouds_.size(), native_multi_scan_groups_, native_merged_scans_, cp_commands_,
+           repaired_merged_away_, (int)cp_control_valid_, cp_control_pos_[0], cp_control_pos_[1],
+           cp_control_pos_[2], cp_control_points_);
