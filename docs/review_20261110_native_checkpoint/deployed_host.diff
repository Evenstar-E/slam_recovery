+}
+
+// One command per file: <dir>/cmd is written atomically by the driver (write - rename) and is
+// renamed to cmd.done before it runs, so a command is executed exactly once even if the poll
+// happens to come back to an unchanged directory.
+void LIVMapper::startControlThread()
+{
+  if (cp_ctrl_started_) return;
+  cp_ctrl_started_ = true;
+  cp_ctrl_thread_ = std::thread(&LIVMapper::controlThreadLoop, this);
+  ROS_INFO("[NATIVE_CHECKPOINT] control thread started on %s", cp_ctrl_dir_.c_str());
+}
+
+// Receipt is separated from application on purpose: the host can be slow inside one LIO frame, and
+// a caller that waits for "applied" then cannot tell a slow frame from a dead host. The thread
+// acknowledges as soon as it has the command; the main loop applies it at a frame boundary.
+void LIVMapper::controlThreadLoop()
+{
+  const std::string cmd_path = cp_ctrl_dir_ + "/cmd";
+  const std::string ack_path = cp_ctrl_dir_ + "/ack_received";
+  while (!cp_ctrl_stop_.load())
+  {
+    std::ifstream in(cmd_path);
+    if (in.good())
+    {
+      std::string cmd, payload;
+      std::getline(in, cmd);
+      std::getline(in, payload);
+      in.close();
+      if (!cmd.empty())
+      {
+        std::rename(cmd_path.c_str(), (cp_ctrl_dir_ + "/cmd.done").c_str());
+        {
+          std::lock_guard<std::mutex> lk(cp_pending_mtx_);
+          cp_pending_cmd_ = cmd;
+          cp_pending_payload_ = payload;
+          cp_has_pending_.store(true);
+          cp_received_++;
+        }
+        // system_clock, not a monotonic clock: the driver compares this with its own time.time().
+        const double recv_s =
+            std::chrono::duration<double>(std::chrono::system_clock::now().time_since_epoch()).count();
+        std::ofstream out(ack_path, std::ios::trunc);
+        out << "RECEIVED " << cmd << " wall=" << std::fixed << std::setprecision(6) << recv_s << "\n";
+      }
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+  }
+}
+
+// Called at the top of each frame in the main loop. Everything here runs on the estimator's thread,
+// at a frame boundary, exactly as the synchronous path did.
+bool LIVMapper::applyPendingControlCommand()
+{
+  if (!cp_has_pending_.load()) return false;
+  std::string cmd, payload;
+  {
+    std::lock_guard<std::mutex> lk(cp_pending_mtx_);
+    cmd = cp_pending_cmd_;
+    payload = cp_pending_payload_;
+    cp_has_pending_.store(false);
+  }
+  if (cmd.empty()) return false;
+  cp_applied_commands_++;
+  bool ok = false;
+  std::string detail;
+  if (cmd == "snapshot")
+  {
+    ok = snapshotCheckpoint();
+    detail = checkpointStatus();
+  }
+  else if (cmd == "restore")
+  {
+    ok = restoreCheckpoint();
+    detail = checkpointStatus();
+  }
+  else if (cmd == "reprocess_control")
+  {
+    ok = reprocessCheckpoint(false, true);
+    detail = checkpointStatus();
+  }
+  else if (cmd == "reprocess")
+  {
+    ok = reprocessCheckpoint(true, false);
+    detail = checkpointStatus();
+  }
+  else if (cmd == "hold")
+  {
+    map_hold_ = true;
+    hold_commands_++;
+    ok = true;
+    detail = checkpointStatus();
+  }
+  else if (cmd == "resume")
+  {
+    map_hold_ = false;
+    hold_commands_++;
+    ok = true;
+    detail = checkpointStatus();
+  }
+  else if (cmd == "set_state")
+  {
+    double v[7] = {0, 0, 0, 0, 0, 0, 0};
+    std::istringstream ss(payload);
+    bool parsed = true;
+    for (int i = 0; i < 7; ++i) { if (!(ss >> v[i])) { parsed = false; break; } }
+    if (!parsed) { detail = "set_state: payload must be 7 numbers"; }
+    else
+    {
+      Eigen::Quaterniond q(v[6], v[3], v[4], v[5]);
+      q.normalize();
+      _state.pos_end = V3D(v[0], v[1], v[2]);
+      _state.rot_end = q.toRotationMatrix();
+      state_propagat = _state;
+      voxelmap_manager->state_ = _state;
+      ok = true;
+      cp_commands_++;
+      detail = checkpointStatus();
+    }
+  }
+  else if (cmd == "status")
+  {
+    ok = true;
+    detail = checkpointStatus();
+  }
+  else
+  {
+    detail = "unknown_command";
+  }
+  {
+    std::ofstream out(cp_ctrl_dir_ + "/ack", std::ios::trunc);
+    out << (ok ? "OK " : "FAIL ") << cmd << " " << detail << "\n";
+  }
+  return true;
+}
