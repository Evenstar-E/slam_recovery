+// ------------------------------------------------------------------------------------------------
+// Native checkpoint: the estimator state and the voxel map, copied at one instant and restorable
+// without re-running the input. The map is a tree of raw pointers, so the copy must be explicit;
+// that is the only reason this exists as C++ rather than as a ROS sidecar.
+// ------------------------------------------------------------------------------------------------
+void LIVMapper::repaired_scan_cbk(const sensor_msgs::PointCloud2::ConstPtr &msg)
+{
+  if (msg == nullptr) return;
+  PointCloudXYZI::Ptr cloud(new PointCloudXYZI());
+  // The same preprocessor the raw topic goes through, so a repaired scan carries the same
+  // per-point time offsets and the same filtering as the one it replaces.
+  p_pre->process(msg, cloud);
+  if (cloud->empty())
+  {
+    ROS_WARN("[NATIVE_REPAIR] stamp=%.9f produced an empty cloud; kept out of the queue",
+             msg->header.stamp.toSec());
+    return;
+  }
+  cloud->header.stamp = msg->header.stamp.toNSec() / 1000;
+  const int64_t ns = (int64_t)msg->header.stamp.toNSec();
+  {
+    std::lock_guard<std::mutex> lk(repaired_mtx_);
+    repaired_clouds_[ns] = cloud;
+    repaired_received_++;
+    // A repaired scan that never finds its group would otherwise accumulate for the whole run.
+    while (repaired_clouds_.size() > 64)
+    {
+      repaired_clouds_.erase(repaired_clouds_.begin());
+      repaired_dropped_++;
+    }
+  }
+  ROS_INFO("[NATIVE_REPAIR] received stamp=%.9f points=%zu", msg->header.stamp.toSec(),
+           cloud->size());
+}
+
+bool LIVMapper::applyRepairedScan(LidarMeasureGroup &meas)
+{
+  if (repaired_clouds_.empty()) return false;
+  std::lock_guard<std::mutex> lk(repaired_mtx_);
+  if (repaired_clouds_.empty()) return false;
+
+  // The stamp that identifies a published repair is the scan's header time (its begin). The group
+  // does not carry that directly in this mode -- lidar_frame_beg_time is only set on scan-start
+  // groups and the PCL headers are not propagated -- but the end time is exact and the scan's
+  // last point carries its own offset from the begin, so begin = lio_time - last_curvature.
+  // A repaired scan published at t is the scan whose group ends at t + duration. The group's own
+  // end time is exact, so the rule needs no derived begin: take the repair with the largest stamp
+  // that is at most one scan before this group's end. Measured: every leftover repair had such a
+  // group (11 of 11), so this is the rule that can actually consume them.
+  if (!meas.measures.empty() && meas.measures.back().lio_time > 0)
+  {
+    const double end = meas.measures.back().lio_time;
+    auto best = repaired_clouds_.end();
+    for (auto it = repaired_clouds_.begin(); it != repaired_clouds_.end(); ++it)
+    {
+      const double t = (double)it->first * 1e-9;
+      if (t <= end + 1e-6 && end - t <= 0.2)
+      {
+        if (best == repaired_clouds_.end() || t > (double)best->first * 1e-9) best = it;
+      }
+    }
+    if (best != repaired_clouds_.end())
+    {
+      meas.lidar = best->second;
+      meas.pcl_proc_cur = best->second;
+      repaired_applied_++;
+      ROS_INFO("[NATIVE_REPAIR] applied by group end=%.9f stamp=%.9f (dt=%.6f s) points=%zu",
+               end, (double)best->first * 1e-9, end - (double)best->first * 1e-9,
+               best->second->size());
+      repaired_clouds_.erase(best);
+      return true;
+    }
+    return false;
+  }
+
+  // A group assembled from merged scans knows the span it covers. A repaired scan belongs to it
+  // exactly when its own stamp lies inside that span; the cloud can only carry one of them, so the
+  // rest are counted as merged away rather than silently dropped.
+  if (meas.native_scan_first > 0 && meas.native_scan_last >= meas.native_scan_first)
+  {
+    if (repair_probe_ < 12 && !repaired_clouds_.empty())
+    {
+      repair_probe_++;
+      ROS_INFO("[NATIVE_REPAIR] span probe [%.9f .. %.9f] queue=[%.9f .. %.9f] n=%zu",
+               meas.native_scan_first, meas.native_scan_last,
+               (double)repaired_clouds_.begin()->first * 1e-9,
+               (double)repaired_clouds_.rbegin()->first * 1e-9, repaired_clouds_.size());
+    }
+    const double lo = meas.native_scan_first - 1e-3;
+    const double hi = meas.native_scan_last + 1e-3;
+    auto best = repaired_clouds_.end();
+    size_t in_span = 0;
+    for (auto it = repaired_clouds_.begin(); it != repaired_clouds_.end(); ++it)
+    {
+      const double t = (double)it->first * 1e-9;
+      if (t >= lo && t <= hi)
+      {
+        in_span++;
+        if (best == repaired_clouds_.end() || t > (double)best->first * 1e-9) best = it;
+      }
+    }
+    if (best == repaired_clouds_.end()) return false;
+    meas.lidar = best->second;
+    meas.pcl_proc_cur = best->second;
+    repaired_applied_++;
+    repaired_merged_away_ += (in_span > 1 ? in_span - 1 : 0);
+    ROS_INFO("[NATIVE_REPAIR] applied in span [%.9f .. %.9f] stamp=%.9f points=%zu (merged away %zu)",
+             meas.native_scan_first, meas.native_scan_last, (double)best->first * 1e-9,
+             best->second->size(), in_span > 1 ? in_span - 1 : 0);
+    repaired_clouds_.erase(best);
+    return true;
+  }
+
+  double target = 0.0;
+  bool derived = false;
+  if (meas.lidar && meas.lidar->header.stamp != 0)
+  {
+    target = (double)meas.lidar->header.stamp / 1e6;
+  }
+  else if (!meas.measures.empty())
+  {
+    const PointCloudXYZI::Ptr src = (meas.pcl_proc_cur && !meas.pcl_proc_cur->empty())
+                                        ? meas.pcl_proc_cur
+                                        : meas.lidar;
+    const double dur = (src && !src->empty()) ? src->points.back().curvature / 1000.0 : 0.0;
+    target = meas.measures.back().lio_time - dur;
+    derived = true;
+  }
+  if (repair_probe_ < 5)
+  {
+    repair_probe_++;
+    ROS_INFO("[NATIVE_REPAIR] probe derived=%d target=%.9f lio_t=%.9f queued=%zu",
+             (int)derived, target,
+             meas.measures.empty() ? -1.0 : meas.measures.back().lio_time, repaired_clouds_.size());
+  }
+  if (target <= 0.0) return false;
+  auto best = repaired_clouds_.end();
+  // Exact when the cloud carries its header (1 ms); when the begin time is derived from the scan
+  // end it is off by the difference between the last point's offset and the full scan duration,
+  // measured at ~9 ms here. 20 ms still separates two scans of a 10 Hz sensor by 5x.
+  double best_dt = derived ? 0.02 : 1e-3;
+  for (auto it = repaired_clouds_.begin(); it != repaired_clouds_.end(); ++it)
+  {
+    const double dt = fabs((double)it->first * 1e-9 - target);
+    if (dt <= best_dt)
+    {
+      best_dt = dt;
+      best = it;
+    }
+  }
+  if (best == repaired_clouds_.end())
+  {
+    if (repaired_nomatch_logged_ < 8)
+    {
+      double nearest_dt = 1e9;
+      for (auto it = repaired_clouds_.begin(); it != repaired_clouds_.end(); ++it)
+      {
+        const double d = (double)it->first * 1e-9 - target;
+        if (fabs(d) < fabs(nearest_dt)) nearest_dt = d;
+      }
+      repaired_nomatch_logged_++;
+      ROS_INFO("[NATIVE_REPAIR] no match: target=%.9f nearest_dt=%.6f n=%zu",
+               target, nearest_dt, repaired_clouds_.size());
+    }
+    // No eviction here. A VIO group's time can sit ahead of the scans around it, and evicting on
+    // that alone threw away scans that had not been replayed yet. Leftovers are counted once, at
+    // the end of the replay, where "unmatched" actually means something.
+    return false;
+  }
+  meas.lidar = best->second;
+  meas.pcl_proc_cur = best->second;
+  repaired_applied_++;
+  ROS_INFO("[NATIVE_REPAIR] applied stamp=%.9f (group %.9f, dt=%.6f s) points=%zu",
+           (double)best->first * 1e-9, target, best_dt, best->second->size());
+  repaired_clouds_.erase(best);
+  return true;
+}
+
+bool LIVMapper::snapshotCheckpoint()
+{
+  cp_state_ = _state;
+  cp_state_propagat_ = state_propagat;
+  native_checkpoint::freeMap(cp_map_);
+  cp_map_ = native_checkpoint::cloneMap(voxelmap_manager->voxel_map_);
+  p_imu->getCheckpointState(cp_last_imu_, cp_last_prop_end_time_, cp_acc_s_last_, cp_angvel_last_);
+  // Everything processed from here on is what a replay has to re-derive.
+  replay_buffer_.clear();
+  replay_capture_ = true;
+  cp_valid_ = true;
+  cp_stamp_ = LidarMeasures.last_lio_update_time;
+  cp_frame_num_ = frame_num;
+  cp_voxels_ = cp_map_.size();
+  cp_nodes_ = native_checkpoint::countNodes(cp_map_);
+  cp_points_ = native_checkpoint::countPoints(cp_map_);
+  ROS_INFO("[NATIVE_CHECKPOINT] snapshot stamp=%.9f frame=%d voxels=%zu nodes=%zu points=%zu",
+           cp_stamp_, cp_frame_num_, cp_voxels_, cp_nodes_, cp_points_);
+  return true;
+}
+
+bool LIVMapper::restoreCheckpoint()
+{
+  if (!cp_valid_)
+  {
+    ROS_WARN("[NATIVE_CHECKPOINT] restore refused: no snapshot has been taken");
+    return false;
+  }
+  const size_t live_before = voxelmap_manager->voxel_map_.size();
+  const size_t pts_before = native_checkpoint::countPoints(voxelmap_manager->voxel_map_);
+  native_checkpoint::freeMap(voxelmap_manager->voxel_map_);
+  voxelmap_manager->voxel_map_ = native_checkpoint::cloneMap(cp_map_);
+  _state = cp_state_;
+  state_propagat = cp_state_propagat_;
+  voxelmap_manager->state_ = _state;
+  p_imu->setCheckpointState(cp_last_imu_, cp_last_prop_end_time_, cp_acc_s_last_, cp_angvel_last_);
+  // A restored map is the map that was built before the checkpoint, so the "first frame built the
+  // map" path must not run again on the next LIO update.
+  lidar_map_inited = true;
+  cp_restores_++;
+  ROS_INFO("[NATIVE_CHECKPOINT] restore #%zu: live map %zu voxels/%zu points -> %zu voxels/%zu points",
+           cp_restores_, live_before, pts_before, voxelmap_manager->voxel_map_.size(),
+           native_checkpoint::countPoints(voxelmap_manager->voxel_map_));
+  return true;
+}
+
+// Restore, then re-run the host's own propagation and LIO update for every group captured since
+// the snapshot. This is reprocessing in the host, not a Python rollback: the map is rebuilt by
+// UpdateVoxelMap and the state comes out of VoxelMapManager::StateEstimation.
+bool LIVMapper::reprocessCheckpoint(bool apply_repairs, bool keep_buffer)
+{
+  const size_t n = replay_buffer_.size();
+  if (!restoreCheckpoint())
+  {
+    return false;
+  }
+  if (n == 0)
+  {
+    ROS_WARN("[NATIVE_CHECKPOINT] reprocess: nothing was captured between snapshot and now");
+    replay_capture_ = false;
+    return true;
+  }
+  // The replay has to be able to write: the hold that keeps quarantine frames out of the map
+  // would otherwise also keep the repaired replay out, and the map would come back unchanged.
+  const bool hold_was = map_hold_;
+  map_hold_ = false;
+  replay_mode_ = true;
+  double span_lo = 1e18, span_hi = -1e18;
+  std::vector<std::pair<double, double>> group_spans;
+  std::vector<double> group_times;              // lio_time of every replayed group
+  group_spans.reserve(n);
+  group_times.reserve(n);
+  for (size_t i = 0; i < n; ++i)
+  {
+    LidarMeasures = replay_buffer_[i];
+    // A repaired scan for this frame replaces the measurement the host originally used. This is
+    // where the substitution belongs: a repair is decided after the frame was processed, so it can
+    // only enter through the replay -- the live path has usually consumed the group already.
+    if (!LidarMeasures.measures.empty())
+    {
+      const double t = LidarMeasures.measures.back().lio_time;
+      if (t > 0) { if (t < span_lo) span_lo = t; if (t > span_hi) span_hi = t; group_times.push_back(t); }
+    }
+    if (LidarMeasures.native_scan_first > 0)
+    {
+      group_spans.emplace_back(LidarMeasures.native_scan_first, LidarMeasures.native_scan_last);
+    }
+    if (apply_repairs) applyRepairedScan(LidarMeasures);
+    handleFirstFrame();
+    processImu();
+    // Whether the frame actually carried points is the difference between a replay and an empty
+    // pass: handleLIO returns early on an empty cloud and writes nothing.
+    {
+      const size_t n_cur = LidarMeasures.pcl_proc_cur ? LidarMeasures.pcl_proc_cur->size() : 0;
+      const size_t n_und = feats_undistort ? feats_undistort->size() : 0;
+      const bool is_lio = (LidarMeasures.lio_vio_flg == LIO || LidarMeasures.lio_vio_flg == LO);
+      if (is_lio) { replay_lio_frames_++; if (n_und > 0) replay_lio_with_points_++; else replay_lio_empty_++; }
+      else { replay_vio_frames_++; }
+      if (n_und > 0) { replay_frames_with_points_++; replay_points_total_ += n_und; }
+      else replay_frames_empty_++;
+      if (replay_trace_.size() < 600)
+      {
+        replay_trace_.push_back({ (double)replay_trace_.size(), (double)n_cur, (double)n_und });
+      }
+    }
+    stateEstimationAndMapping();
+  }
+  replay_mode_ = false;
+  map_hold_ = hold_was;
+  // Anything still queued was published for a frame this replay did not cover.
+  if (apply_repairs)
+  {
+    std::lock_guard<std::mutex> lk(repaired_mtx_);
+    // Classify what found no frame: a repair whose stamp lies inside a replayed group's span had a
+    // frame and still did not replace it; one outside every span had no frame at all. Those are
+    // different faults and only the first is a matching problem.
+    // A repaired scan published at t belongs to the group whose scan ends at t + duration, i.e.
+    // a group time in (t, t + 0.2]. If there is none, the repair was published for a scan this
+    // replay never had a group for -- a different fault from "it had a group and still missed".
+    size_t had_group = 0, no_group = 0;
+    std::string had_stamps, no_stamps;
+    char buf[64];
+    for (auto it = repaired_clouds_.begin(); it != repaired_clouds_.end(); ++it)
+    {
+      const double t = (double)it->first * 1e-9;
+      bool near = false;
+      for (double g : group_times)
+      {
+        if (g > t && g <= t + 0.2) { near = true; break; }
+      }
+      snprintf(buf, sizeof(buf), " %.6f", t);
+      if (near) { had_group++; had_stamps += buf; } else { no_group++; no_stamps += buf; }
+    }
+    ROS_INFO("[NATIVE_REPAIR] leftover %zu: had_group_but_missed=%zu no_group_nearby=%zu "
+             "(groups=%zu, spans=%zu)", repaired_clouds_.size(), had_group, no_group,
+             group_times.size(), group_spans.size());
+    if (!had_stamps.empty()) ROS_INFO("[NATIVE_REPAIR] missed-with-group:%s", had_stamps.c_str());
+    if (!no_stamps.empty()) ROS_INFO("[NATIVE_REPAIR] no-group:%s", no_stamps.c_str());
+    repaired_dropped_ += repaired_clouds_.size();
+    repaired_clouds_.clear();
+  }
+  if (keep_buffer)
+  {
+    // The control pass keeps the frames so the repaired pass can run over exactly the same ones.
+    replay_capture_ = false;
+  }
+  else
+  {
+    replay_buffer_.clear();
+  }
+  replay_capture_ = false;
+  if (!apply_repairs)
+  {
+    cp_control_pos_ = _state.pos_end;
+    cp_control_points_ = native_checkpoint::countPoints(voxelmap_manager->voxel_map_);
+    cp_control_valid_ = true;
+  }
+  cp_replays_++;
+  cp_replay_frames_ += n;
+  ROS_INFO("[NATIVE_CHECKPOINT] replay points: with_points=%zu empty=%zu total_undistorted=%zu "
+           "| LIO frames=%zu with_points=%zu empty=%zu | VIO frames=%zu",
+           replay_frames_with_points_, replay_frames_empty_, replay_points_total_,
+           replay_lio_frames_, replay_lio_with_points_, replay_lio_empty_, replay_vio_frames_);
+  ROS_INFO("[NATIVE_CHECKPOINT] reprocess #%zu: %zu frames replayed over [%.9f .. %.9f], "
+           "repairs applied=%zu queued=%zu, map now %zu voxels/%zu points",
+           cp_replays_, n, span_lo, span_hi, repaired_applied_, repaired_clouds_.size(),
+           voxelmap_manager->voxel_map_.size(),
+           native_checkpoint::countPoints(voxelmap_manager->voxel_map_));
+  return true;
+}
