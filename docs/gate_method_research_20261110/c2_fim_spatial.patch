+# RESEARCH PATCH -- not integrated. Changes exactly two things:
+#   1. the evaluation sample is voxel centroids at VOXEL_M (spatial, order/duplication invariant)
+#      instead of `pts[::step]`, whose step is a function of the input point count;
+#   2. the neighbourhood is a fixed radius instead of a fixed count, so the sample does not change
+#      when the input list gets longer or shorter.
+# Everything else (mean over points, 1/sigma^2, the eigen analysis, the weak-direction choice,
+# the 1e-6 regularisation) is unchanged.
+VOXEL_M = 0.25      # four-arm experiment's VOXEL_CELL; same order as the reference resolution
+RADIUS_M = 0.6      # 2.4x the voxel: nearest surface layer, not across separate surfaces
+MIN_NEIGHBOURS = 6
+
+
+def voxel_centroids(points: np.ndarray, voxel_m: float = VOXEL_M) -> np.ndarray:
+    pts = np.asarray(points, dtype=np.float64)[:, :3]
+    if not len(pts):
+        return pts
+    keys = np.floor(pts / float(voxel_m)).astype(np.int64)
+    order = np.lexsort((keys[:, 2], keys[:, 1], keys[:, 0]))
+    keys, pts = keys[order], pts[order]
+    new = np.ones(len(pts), dtype=bool)
+    new[1:] = np.any(keys[1:] != keys[:-1], axis=1)
+    starts = np.flatnonzero(new)
+    ends = np.append(starts[1:], len(pts))
+    return np.array([pts[s:e].mean(axis=0) for s, e in zip(starts, ends)])
+
+
