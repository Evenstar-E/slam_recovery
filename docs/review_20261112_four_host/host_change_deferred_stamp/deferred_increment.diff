+void LIVMapper::applyDeferredControlCommands(double now_lio_s)
+{
+  std::vector<std::pair<std::string, std::string>> due;
+  std::vector<int64_t> stamps;
+  {
+    std::lock_guard<std::mutex> lk(cp_deferred_mtx_);
+    const int64_t now_ns = (now_lio_s > 0.0) ? (int64_t)std::llround(now_lio_s * 1e9) : 0;
+    while (!cp_deferred_cmd_.empty() && now_ns > 0)
+    {
+      const int64_t stamp_ns = cp_deferred_stamp_.front();
+      if (now_ns < stamp_ns) break;
+      due.emplace_back(cp_deferred_cmd_.front(), cp_deferred_payload_.front());
+      stamps.push_back(stamp_ns);
+      cp_deferred_cmd_.pop_front();
+      cp_deferred_payload_.pop_front();
+      cp_deferred_stamp_.pop_front();
+    }
+  }
+  for (size_t i = 0; i < due.size(); ++i)
+  {
+    std::string detail;
+    const bool ok = executeControlCommand(due[i].first, due[i].second, detail);
+    cp_applied_commands_++;
+    const double late_ms =
+        (double)((int64_t)std::llround(now_lio_s * 1e9) - stamps[i]) / 1e6;
+    ROS_INFO("[NATIVE_CHECKPOINT] deferred apply cmd=%s at_lio=%.9f stamp_ns=%lld "
+             "late_ms=%.3f ok=%d %s",
+             due[i].first.c_str(), now_lio_s, (long long)stamps[i], late_ms,
+             (int)ok, detail.c_str());
+  }
+}
