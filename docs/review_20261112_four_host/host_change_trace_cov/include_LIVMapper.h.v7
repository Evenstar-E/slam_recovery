#ifndef LIV_MAPPER_H
#define LIV_MAPPER_H

#include "IMU_Processing.h"
#include "vio.h"
#include "preprocess.h"
#include <deque>
#include <cv_bridge/cv_bridge.h>
#include <image_transport/image_transport.h>
#include <nav_msgs/Path.h>
#include <vikit/camera_loader.h>
#ifdef DET_SYNC
#include <condition_variable>
#include <atomic>
#include <mutex>
#include <thread>
#endif

class LIVMapper
{
public:
  LIVMapper(ros::NodeHandle &nh);
  ~LIVMapper();
  void initializeSubscribersAndPublishers(ros::NodeHandle &nh, image_transport::ImageTransport &it);
  void initializeComponents();
  void initializeFiles();
  void run();

  // Native checkpoint (recovery mainline, minimal): the host's own state and voxel map, copied at
  // one logical instant and restorable without re-running the input. Driven by a directory of
  // command files (~native_checkpoint_dir) so no new ROS interface has to exist for it.
  // Repaired-measurement injection: a scan published on the repair topic replaces the raw one for
  // the group whose begin time matches its header stamp, before propagation or estimation sees it.
  void repaired_scan_cbk(const sensor_msgs::PointCloud2::ConstPtr &msg);
  bool applyRepairedScan(LidarMeasureGroup &meas);

  bool snapshotCheckpoint();
  bool restoreCheckpoint();
  bool reprocessCheckpoint(bool apply_repairs = true, bool keep_buffer = false,
                           int64_t end_stamp_ns = 0);
  void pollCheckpointControl();
  // Control channel: a thread watches the command directory and acknowledges receipt at once; the
  // command itself is applied at a frame boundary by the main loop. The thread never touches the
  // estimator, the map or LIO -- it only moves a command from the directory into a slot.
  void startControlThread();
  void controlThreadLoop();
  bool applyPendingControlCommand();
  std::string checkpointStatus() const;
#ifdef DET_SYNC
  // DET_SYNC: the main loop blocks until a lidar callback signals instead of polling at 5 kHz.
  // Recorded, not adjusted: the processing itself is unchanged.
  std::mutex det_mtx_;
  std::condition_variable det_cv_;
#endif
  void gravityAlignment();
  void handleFirstFrame();
  void stateEstimationAndMapping();
  void handleVIO();
  void handleLIO();
  void savePCD();
  void processImu();
  // Writes one ALI-H trace row. Called at the end of handleLIO() when a posterior exists
  // (has_out=1) or on the early-return path before StateEstimation ran (has_out=0).
  void writeTraceCovRow(double rel_time, int has_out, const Eigen::Matrix<double, 6, 6> &P_pre);
  
  bool sync_packages(LidarMeasureGroup &meas);
  void prop_imu_once(StatesGroup &imu_prop_state, const double dt, V3D acc_avr, V3D angvel_avr);
  void imu_prop_callback(const ros::TimerEvent &e);
  void transformLidar(const Eigen::Matrix3d rot, const Eigen::Vector3d t, const PointCloudXYZI::Ptr &input_cloud, PointCloudXYZI::Ptr &trans_cloud);
  void pointBodyToWorld(const PointType &pi, PointType &po);
  void RGBpointBodyLidarToIMU(PointType const *const pi, PointType *const po);
  void RGBpointBodyToWorld(PointType const *const pi, PointType *const po);
  void standard_pcl_cbk(const sensor_msgs::PointCloud2::ConstPtr &msg);
  void livox_pcl_cbk(const livox_ros_driver::CustomMsg::ConstPtr &msg_in);
  void imu_cbk(const sensor_msgs::Imu::ConstPtr &msg_in);
  void img_cbk(const sensor_msgs::ImageConstPtr &msg_in);
  void publish_img_rgb(const image_transport::Publisher &pubImage, VIOManagerPtr vio_manager);
  void publish_frame_world(const ros::Publisher &pubLaserCloudFullRes, VIOManagerPtr vio_manager);
  void publish_visual_sub_map(const ros::Publisher &pubSubVisualMap);
  void publish_effect_world(const ros::Publisher &pubLaserCloudEffect, const std::vector<PointToPlane> &ptpl_list);
  void publish_odometry(const ros::Publisher &pubOdomAftMapped);
  void publish_mavros(const ros::Publisher &mavros_pose_publisher);
  void publish_path(const ros::Publisher pubPath);
  void readParameters(ros::NodeHandle &nh);
  template <typename T> void set_posestamp(T &out);
  template <typename T> void pointBodyToWorld(const Eigen::Matrix<T, 3, 1> &pi, Eigen::Matrix<T, 3, 1> &po);
  template <typename T> Eigen::Matrix<T, 3, 1> pointBodyToWorld(const Eigen::Matrix<T, 3, 1> &pi);
  cv::Mat getImageFromMsg(const sensor_msgs::ImageConstPtr &img_msg);

  std::mutex mtx_buffer, mtx_buffer_imu_prop;
  std::condition_variable sig_buffer;

  SLAM_MODE slam_mode_;
  std::unordered_map<VOXEL_LOCATION, VoxelOctoTree *> voxel_map;
  
  string root_dir;
  string lid_topic, imu_topic, seq_name, img_topic;
  V3D extT;
  M3D extR;

  int feats_down_size = 0, max_iterations = 0;

  double res_mean_last = 0.05;
  double gyr_cov = 0, acc_cov = 0, inv_expo_cov = 0;
  double blind_rgb_points = 0.0;
  double last_timestamp_lidar = -1.0, last_timestamp_imu = -1.0, last_timestamp_img = -1.0;
  double filter_size_surf_min = 0;
  double filter_size_pcd = 0;
  double _first_lidar_time = 0.0;
  double match_time = 0, solve_time = 0, solve_const_H_time = 0;

  bool lidar_map_inited = false, pcd_save_en = false, img_save_en = false, pub_effect_point_en = false, pose_output_en = false, ros_driver_fix_en = false, hilti_en = false;
  int img_save_interval = 1, pcd_save_interval = -1, pcd_save_type = 0;
  int pub_scan_num = 1;

  StatesGroup imu_propagate, latest_ekf_state;

  bool new_imu = false, state_update_flg = false, imu_prop_enable = true, ekf_finish_once = false;
  deque<sensor_msgs::Imu> prop_imu_buffer;
  sensor_msgs::Imu newest_imu;
  double latest_ekf_time;
  nav_msgs::Odometry imu_prop_odom;
  ros::Publisher pubImuPropOdom;
  double imu_time_offset = 0.0;
  double lidar_time_offset = 0.0;

  bool gravity_align_en = false, gravity_align_finished = false;

  bool sync_jump_flag = false;

  bool lidar_pushed = false, imu_en, gravity_est_en, flg_reset = false, ba_bg_est_en = true;
  bool dense_map_en = false;
  int img_en = 1, imu_int_frame = 3;
  bool normal_en = true;
  bool exposure_estimate_en = false;
  double exposure_time_init = 0.0;
  bool inverse_composition_en = false;
  bool raycast_en = false;
  int lidar_en = 1;
  bool is_first_frame = false;
  int grid_size, patch_size, grid_n_width, grid_n_height, patch_pyrimid_level;
  double outlier_threshold;
  double plot_time;
  int frame_cnt;
  double img_time_offset = 0.0;
  deque<PointCloudXYZI::Ptr> lid_raw_data_buffer;
  deque<double> lid_header_time_buffer;
  deque<sensor_msgs::Imu::ConstPtr> imu_buffer;
  deque<cv::Mat> img_buffer;
  deque<double> img_time_buffer;
  vector<pointWithVar> _pv_list;
  vector<double> extrinT;
  vector<double> extrinR;
  vector<double> cameraextrinT;
  vector<double> cameraextrinR;
  double IMG_POINT_COV;

  PointCloudXYZI::Ptr visual_sub_map;
  PointCloudXYZI::Ptr feats_undistort;
  PointCloudXYZI::Ptr feats_down_body;
  PointCloudXYZI::Ptr feats_down_world;
  PointCloudXYZI::Ptr pcl_w_wait_pub;
  PointCloudXYZI::Ptr pcl_wait_pub;
  PointCloudXYZRGB::Ptr pcl_wait_save;
  PointCloudXYZI::Ptr pcl_wait_save_intensity;

  ofstream fout_pre, fout_out, fout_visual_pos, fout_lidar_pos, fout_points;

  // ALI-H v1 diagnostic trace (opt-in, default off; private param "~trace_cov").
  // One row per LIO frame with the propagated (P-) and updated (P+) covariance blocks,
  // the update's local quantities and the exact innovation aggregates. Nothing written
  // here is read back by the estimator, the map or the recovery control path.
  bool trace_cov_en = false;
  ofstream fout_cov;
  long trace_cov_rows = 0;

  pcl::VoxelGrid<PointType> downSizeFilterSurf;

  V3D euler_cur;

  LidarMeasureGroup LidarMeasures;
  StatesGroup _state;
  StatesGroup  state_propagat;

  nav_msgs::Path path;
  nav_msgs::Odometry odomAftMapped;
  geometry_msgs::Quaternion geoQuat;
  geometry_msgs::PoseStamped msg_body_pose;

  PreprocessPtr p_pre;
  ImuProcessPtr p_imu;
  VoxelMapManagerPtr voxelmap_manager;
  VIOManagerPtr vio_manager;

  ros::Publisher plane_pub;
  ros::Publisher voxel_pub;
  ros::Subscriber sub_pcl;
  ros::Subscriber sub_imu;
  ros::Subscriber sub_img;
  ros::Publisher pubLaserCloudFullRes;
  ros::Publisher pubNormal;
  ros::Publisher pubSubVisualMap;
  ros::Publisher pubLaserCloudEffect;
  ros::Publisher pubLaserCloudMap;
  ros::Publisher pubOdomAftMapped;
  ros::Publisher pubPath;
  ros::Publisher pubLaserCloudDyn;
  ros::Publisher pubLaserCloudDynRmed;
  ros::Publisher pubLaserCloudDynDbg;
  image_transport::Publisher pubImage;
  ros::Publisher mavros_pose_publisher;
  ros::Timer imu_prop_timer;

  // Checkpoint contents. Deliberately only these: the states the estimator continues from and the
  // map it continues into.
  StatesGroup cp_state_;
  StatesGroup cp_state_propagat_;
  std::unordered_map<VOXEL_LOCATION, VoxelOctoTree *> cp_map_;
  bool cp_valid_ = false;
  double cp_stamp_ = -1.0;
  int cp_frame_num_ = 0;
  size_t cp_voxels_ = 0, cp_points_ = 0, cp_nodes_ = 0;
  size_t cp_restores_ = 0;
  size_t cp_commands_ = 0;
  // The control pass: same checkpoint, same buffered frames, repairs not applied. The difference
  // between this and the repaired pass is the repair effect, with no run-to-run variation in it.
  V3D cp_control_pos_ = V3D::Zero();
  size_t cp_control_points_ = 0;
  bool cp_control_valid_ = false;
  // The IMU pre-integrator carries four values across frames (last_imu, last_prop_end_time and the
  // last corrected acc/gyro). Without them a replay from the checkpoint would not reproduce the
  // propagation the host itself did, so they are part of the checkpoint, not a convenience.
  sensor_msgs::ImuConstPtr cp_last_imu_;
  double cp_last_prop_end_time_ = -1.0;
  V3D cp_acc_s_last_;
  V3D cp_angvel_last_;
  // Groups processed after the snapshot, replayed on demand. Capture is off unless a snapshot is
  // live; replay mode suppresses publication so a replayed frame is never mistaken for new input.
  // Isolation hold: while set, LIO still propagates and estimates, but nothing is folded into
  // the map. Cleared by "resume", which is the host side of the recovery loop's re-arm.
  bool map_hold_ = false;
  size_t held_frames_ = 0, held_points_ = 0, hold_commands_ = 0;

  ros::Subscriber sub_repaired_scan;
  std::mutex repaired_mtx_;
  std::map<int64_t, PointCloudXYZI::Ptr> repaired_clouds_;   // header stamp ns -> preprocessed
  size_t repaired_applied_ = 0, repaired_dropped_ = 0, repaired_received_ = 0;
  size_t repaired_nomatch_logged_ = 0, repair_probe_ = 0, stamp_probe_ = 0;
  // How many scans the host merged into one measurement group: the reason a repaired scan can
  // legitimately have no frame of its own.
  size_t native_multi_scan_groups_ = 0, native_merged_scans_ = 0;
  size_t repaired_merged_away_ = 0;
  // Per-frame replay evidence: a frame whose undistorted cloud is empty was never processed by
  // handleLIO, which is how the shallow-capture bug looked from the outside.
  size_t replay_frames_with_points_ = 0, replay_frames_empty_ = 0, replay_points_total_ = 0;
  size_t replay_lio_frames_ = 0, replay_lio_with_points_ = 0, replay_lio_empty_ = 0, replay_vio_frames_ = 0;
  std::vector<std::array<double, 3>> replay_trace_;   // (index, cloud points, undistorted points)

  std::vector<LidarMeasureGroup> replay_buffer_;
  bool replay_capture_ = false;
  bool replay_mode_ = false;
  size_t cp_replays_ = 0, cp_replay_frames_ = 0;
  // Last replay's split, exposed in the status ack so the driver can decide whether the host's own
  // state already reached the captured boundary.
  size_t cp_replay_within_ = 0, cp_replay_suffix_ = 0;
  // lio_time of the last group the estimator actually folded in. A snapshot copies that state,
  // so this, not the incoming group's time, is the checkpoint's true timestamp.
  double cp_last_processed_lio_ = -1.0;
  std::string cp_ctrl_dir_;
  std::thread cp_ctrl_thread_;
  std::atomic<bool> cp_ctrl_stop_{false};
  bool cp_ctrl_started_ = false;
  std::mutex cp_pending_mtx_;
  std::string cp_pending_cmd_, cp_pending_payload_;
  std::atomic<bool> cp_has_pending_{false};
  // Commands with an apply stamp are queued and executed in the main loop just before the first
  // group whose lio_time reaches the stamp. The control thread only receives and acknowledges
  // them; it never touches the map.
  std::mutex cp_deferred_mtx_;
  std::deque<std::string> cp_deferred_cmd_, cp_deferred_payload_;
  std::deque<int64_t> cp_deferred_stamp_;
  double cp_last_lio_time_ = -1.0;
  bool executeControlCommand(const std::string &cmd, const std::string &payload,
                             std::string &detail);
  void applyDeferredControlCommands(double now_lio_s);
  size_t cp_received_ = 0, cp_applied_commands_ = 0;
  double cp_last_poll_wall_ = -1.0;

  int frame_num = 0;
  double aver_time_consu = 0;
  double aver_time_icp = 0;
  double aver_time_map_inre = 0;
  bool colmap_output_en = false;
};
#endif